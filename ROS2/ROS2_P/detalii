Pentru a creea un ROS2

# 1. Creăm folderul workspace-ului
mkdir -p ~/ros2_ws/src
cd ~/ros2_ws/src

# 2. Creăm pachetul ROS 2
# Adăugăm dependențele de bază: rclcpp (C++ core), sensor_msgs (imagini), cv_bridge (conversie OpenCV)
ros2 pkg create --build-type ament_cmake yolo_tensorrt --dependencies rclcpp sensor_msgs cv_bridge image_transport std_msgs

# 3. Intrăm în pachet
cd yolo_tensorrt


