<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="743.0" prefWidth="630.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.webcrawler.ControlerView">
   <children>
      <Label layoutX="219.0" layoutY="39.0" prefHeight="46.0" prefWidth="192.0" text="Pagina principala" textAlignment="CENTER" underline="true">
         <font>
            <Font size="25.0" />
         </font>
      </Label>
      <Button fx:id="buton_parsare_link" layoutX="41.0" layoutY="496.0" mnemonicParsing="false" onAction="#switchToSceneLink" prefHeight="127.0" prefWidth="203.0" text="Parsare link-uri de pe site" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="25.0" />
         </font>
      </Button>
      <Button fx:id="buton_parsare_imagini" layoutX="388.0" layoutY="289.0" mnemonicParsing="false" onAction="#switchToSceneImage" prefHeight="127.0" prefWidth="203.0" text="Parsare imagini de pe site" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="25.0" />
         </font>
      </Button>
      <Button fx:id="buton_parsare_text" layoutX="35.0" layoutY="289.0" mnemonicParsing="false" onAction="#switchToSceneText" prefHeight="127.0" prefWidth="203.0" text="Parsare titluri de pe site" textAlignment="CENTER" textOverrun="CLIP" wrapText="true">
         <font>
            <Font size="25.0" />
         </font>
      </Button>
      <Button fx:id="butonResetare" layoutX="473.0" layoutY="142.0" mnemonicParsing="false" onAction="#resetLinkText" prefHeight="46.0" prefWidth="118.0" text="Resetare" wrapText="true">
         <font>
            <Font size="18.0" />
         </font>
      </Button>
      <javafx.scene.control.TextField fx:id="textField" layoutX="35.0" layoutY="142.0" onAction="#resetLinkText" prefHeight="46.0" prefWidth="415.0" promptText="Inserati link-ul site-ului">
         <font>
            <Font size="18.0" />
         </font>
      </javafx.scene.control.TextField>
      <Button fx:id="butonSavePDF" layoutX="388.0" layoutY="496.0" mnemonicParsing="false" onAction="#StageSaveToPDFFormat" prefHeight="127.0" prefWidth="203.0" text="Salvarea tuturor elementelor in format PDF" textAlignment="CENTER" wrapText="true">
         <font>
            <Font size="24.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
